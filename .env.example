# Environment Variables for Medical Domain Fine-Tuning

# Hugging Face token (Requires WRITE permission if pushing models to the hub)
# Get yours here: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Weights & Biases API Key (Used for experiment tracking)
# Get yours here: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
